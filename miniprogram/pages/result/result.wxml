<view wx:if="{{!ready}}" class="page">
  <view class="card">
    <view class="empty">
      <view class="empty__title">{{error || '结果不可用'}}</view>
      <view class="btn btn-sm btn-ghost" bindtap="backHome">返回首页</view>
    </view>
  </view>
</view>

<view wx:else class="page">
  <!-- 演示/模式提示 -->
  <view wx:if="{{demo}}" class="notice notice-warn">
    <view class="notice__title">演示数据</view>
    {{demoLabel || '本次结果由内置示例数据生成，用于验证流程，不能作为真实商品分析。'}}
  </view>

  <!-- 顶部结论 -->
  <view class="verdict">
    <view class="verdict__label">一句话结论</view>
    <view class="verdict__text">{{view.conclusion}}</view>
    <view wx:if="{{view.conclusionDetail}}" class="verdict__meta">{{view.conclusionDetail}}</view>
    <view class="verdict__meta">
      信息完整度：{{view.levelLabel}}（{{view.completenessPercent}}%）
      <text wx:if="{{view.keyMissing.length}}"> · 缺 {{view.keyMissing.length}} 项关键信息</text>
    </view>
  </view>

  <!-- 头部信息 -->
  <view class="card head-card">
    <view class="head-title">{{view.title}}</view>
    <view class="head-meta">
      <text wx:if="{{view.category}}" class="tag tag-accent">{{view.category}}</text>
      <text wx:if="{{view.priceText}}" class="tag tag-muted">{{view.priceText}}</text>
      <text class="tag tag-info">{{view.images.length}} 张图片</text>
      <text class="tag tag-muted">{{view.created}}</text>
    </view>
    <view wx:if="{{view.priceNote}}" class="tiny muted">{{view.priceNote}}</view>

    <scroll-view wx:if="{{view.images.length}}" class="imgs" scroll-x="true">
      <block wx:for="{{view.images}}" wx:key="id">
        <image wx:if="{{item.preview}}" class="img" src="{{item.preview}}" mode="aspectFill" bindtap="previewImage" data-url="{{item.preview}}" />
        <view wx:else class="img img--ph">无预览</view>
      </block>
    </scroll-view>

    <view class="btn-row mt12">
      <view class="btn btn-sm {{isFavorite ? 'btn-ghost' : ''}}" bindtap="toggleFav">{{isFavorite ? '★ 已收藏' : '☆ 收藏'}}</view>
      <view class="btn btn-sm {{inCompare ? 'btn-ghost' : ''}}" bindtap="addToCompare">{{inCompare ? '已加入对比' : '加入对比'}}</view>
      <view class="btn btn-sm" bindtap="copyConclusion">复制结论</view>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="section">
    <view class="section__head">
      <view class="section__title">基本信息</view>
      <view class="section__sub">逐项标注来源与状态</view>
    </view>
    <view class="section__body">
      <field-row wx:for="{{view.sec.basic.items}}" wx:key="key" item="{{item}}" bind:edit="onEditField" />
      <view class="tiny faint">点"手动修正"可以改识别错误；修正后会保留原始识别记录。</view>
    </view>
  </view>

  <!-- 标准解读 -->
  <view class="section">
    <view class="section__head">
      <view class="section__title">标准解读</view>
      <view class="section__sub">{{view.standardStatusLabel}}{{view.lastVerified ? ' · 核验 ' + view.lastVerified : ''}}</view>
    </view>
    <view class="section__body">
      <view wx:for="{{view.sec.standard.items}}" wx:key="key" class="row">
        <view class="row__label">{{item.label}}</view>
        <view class="row__value">
          <text>{{item.value}}</text>
          <view wx:if="{{item.note}}" class="tiny muted">{{item.note}}</view>
        </view>
      </view>
      <view wx:if="{{view.sec.standard.versions.length > 1}}" class="sub-block">
        <view class="tiny muted">同号其他版本</view>
        <view wx:for="{{view.sec.standard.versions}}" wx:key="standard_number" class="tiny">
          {{item.standard_number}} · {{item.status}} · 实施 {{item.implementation_date || '—'}}
        </view>
      </view>
      <view wx:if="{{view.sec.standard.caveats.length}}" class="notice notice-muted mt12">
        <view wx:for="{{view.sec.standard.caveats}}" wx:key="*this" class="tiny">· {{item}}</view>
      </view>
      <view class="btn-row mt12">
        <view class="btn btn-sm btn-ghost" bindtap="goStandard">查看标准详情</view>
        <view class="btn btn-sm" bindtap="openOfficial">复制官方查询链接</view>
      </view>
      <view class="tiny faint mt8">商品页面出现标准号 ≠ 商品经检测符合该标准；本系统不做符合性判定。</view>
    </view>
  </view>

  <!-- 面料与工艺 -->
  <view class="section">
    <view class="section__head">
      <view class="section__title">面料与工艺参考</view>
      <view class="section__sub">通用特性 + 已知参数</view>
    </view>
    <view class="section__body">
      <field-row wx:if="{{view.sec.fabric.composition}}" item="{{view.sec.fabric.composition}}" bind:edit="onEditField" />
      <field-row wx:for="{{view.sec.fabric.items}}" wx:key="key" item="{{item}}" bind:edit="onEditField" />

      <view class="sub-block">
        <view class="h3">克重参考</view>
        <view class="tiny">{{view.sec.fabric.weight_assessment.message}}</view>
        <view wx:if="{{view.sec.fabric.weight_assessment.reference}}" class="tiny muted mt4">
          参考区间 {{view.sec.fabric.weight_assessment.reference.min}}–{{view.sec.fabric.weight_assessment.reference.max}} g/m²
          · 样本数 {{view.sec.fabric.weight_assessment.reference.samples}}
          · {{view.sec.fabric.weight_assessment.reference.source}}
          · 更新 {{view.sec.fabric.weight_assessment.reference.updated_at}}
        </view>
        <view wx:for="{{view.sec.fabric.weight_assessment.limits}}" wx:key="*this" class="tiny faint">· {{item}}</view>
      </view>

      <view class="sub-block">
        <view class="h3">支数参考</view>
        <view class="tiny">{{view.sec.fabric.yarn_assessment.message}}</view>
        <view wx:for="{{view.sec.fabric.yarn_assessment.limits}}" wx:key="*this" class="tiny faint">· {{item}}</view>
      </view>

      <view wx:if="{{view.sec.fabric.fiber_notes.items.length}}" class="sub-block">
        <view class="h3">成分含义</view>
        <view wx:for="{{view.sec.fabric.fiber_notes.items}}" wx:key="fiber" class="fiber">
          <view class="fiber__head">
            <text class="fiber__name">{{item.fiber}}</text>
            <text wx:if="{{item.percent}}" class="tag tag-muted">{{item.percent}}%</text>
            <text wx:if="{{!item.found}}" class="tag tag-warn">知识库未收录</text>
            <text wx:if="{{item.needs_review}}" class="tag tag-muted">待专业审校</text>
          </view>
          <view class="tiny">{{item.plain}}</view>
          <view wx:if="{{item.pros.length}}" class="tiny ok">可能优点：{{item.pros}}</view>
          <view wx:if="{{item.cons.length}}" class="tiny warn">可能局限：{{item.cons}}</view>
          <view wx:if="{{item.note_on_quality}}" class="tiny muted">{{item.note_on_quality}}</view>
        </view>
      </view>

      <view wx:for="{{view.sec.fabric.fiber_notes.summary}}" wx:key="*this" class="tiny muted mt8">· {{item}}</view>
      <view class="tiny faint mt8">{{view.sec.fabric.disclaimer}}</view>
    </view>
  </view>

  <!-- 版型与尺码 -->
  <view class="section">
    <view class="section__head">
      <view class="section__title">版型与尺码</view>
      <view class="section__sub">{{view.sec.fit.status_label}}</view>
    </view>
    <view class="section__body">
      <view wx:if="{{view.sec.fit.recommended_size}}" class="size-box">
        <view class="tiny muted">建议参考尺码</view>
        <view class="size-box__value">{{view.sec.fit.recommended_size}}</view>
        <view class="tiny muted">按尺码表 + 你的偏好推算，不是试穿结果</view>
      </view>
      <view wx:if="{{view.sec.fit.summary}}" class="fit-summary">{{view.sec.fit.summary}}</view>
      <view wx:for="{{view.sec.fit.reasons}}" wx:key="*this" class="tiny reason">· {{item}}</view>
      <view wx:for="{{view.sec.fit.limits}}" wx:key="*this" class="tiny faint">· {{item}}</view>
      <view wx:if="{{view.sec.fit.missing_product.length}}" class="notice notice-warn mt12">
        <view class="notice__title">还缺商品信息</view>
        缺少：{{view.sec.fit.missing_product}}。补齐后才能给更具体的建议。
      </view>
      <view wx:if="{{view.sec.fit.missing_profile.length}}" class="notice notice-info mt12">
        <view class="notice__title">还缺你的信息（可选）</view>
        缺少：{{view.sec.fit.missing_profile}}。系统不会推测你的身体数据。
        <view class="btn btn-sm btn-ghost mt8" bindtap="goKnowledge">了解版型常识</view>
      </view>
    </view>
  </view>

  <!-- 疑点清单 -->
  <view class="section">
    <view class="section__head">
      <view class="section__title">信息可信度与疑点</view>
      <view class="section__sub">重点 {{view.counts.attention}} · 确认 {{view.counts.verify}} · 提示 {{view.counts.info}}</view>
    </view>
    <view class="section__body">
      <view wx:if="{{view.doubts.length === 0}}" class="tiny ok">当前材料下没有需要特别核实的点；这不等于商品没问题，只说明截图里没有明显矛盾。</view>
      <view wx:for="{{view.doubts}}" wx:key="id" class="doubt">
        <view class="doubt__head">
          <text class="doubt__title">{{item.title}}</text>
          <text class="tag tag-{{item.tone}}">{{item.severity_label}}</text>
        </view>
        <view class="doubt__reason">{{item.reason}}</view>
        <view wx:if="{{item.action}}" class="doubt__action">下一步：{{item.action}}</view>
        <view wx:if="{{item.basis.length}}" class="doubt__basis">依据：{{item.category}} · {{item.basis.length}} 条证据</view>
      </view>
    </view>
  </view>

  <!-- 洗护 -->
  <view class="section">
    <view class="section__head">
      <view class="section__title">穿着与洗护</view>
      <view class="section__sub">标签优先，成分为参考</view>
    </view>
    <view class="section__body">
      <field-row item="{{view.sec.care.label_item}}" bind:edit="onEditField" />
      <view wx:if="{{view.sec.care.keywords.length}}" class="tiny">标签中识别到的要求：{{view.sec.care.keywords}}</view>
      <view wx:if="{{view.sec.care.symbols.length}}" class="sub-block">
        <view wx:for="{{view.sec.care.symbols}}" wx:key="text" class="tiny">· {{item.text}}：{{item.meaning}}</view>
      </view>
      <view wx:for="{{view.sec.care.fiber_care}}" wx:key="fiber" class="sub-block">
        <view class="tiny strong">{{item.fiber}} 的通用注意</view>
        <view wx:for="{{item.advice}}" wx:key="*this" wx:for-item="adv" class="tiny muted">· {{adv}}</view>
      </view>
      <view class="tiny muted mt8">{{view.sec.care.note}}</view>
      <view class="tiny faint">{{view.sec.care.caution}}</view>
      <view class="btn btn-sm btn-ghost mt12" bindtap="goKnowledge">去面料知识库看洗护要点</view>
    </view>
  </view>

  <!-- 待确认问题 -->
  <view class="section">
    <view class="section__head">
      <view class="section__title">购买前建议确认</view>
      <view class="section__sub" bindtap="copyQuestions">复制全部</view>
    </view>
    <view class="section__body">
      <view wx:if="{{view.questions.length === 0}}" class="tiny muted">暂无可直接询问的问题。</view>
      <view wx:for="{{view.questions}}" wx:key="*this" class="question">
        <text class="question__idx">{{index + 1}}</text>
        <text class="question__text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 证据清单 -->
  <view class="section">
    <view class="section__head">
      <view class="section__title">证据清单</view>
      <view class="section__sub" bindtap="toggleSection" data-key="evidence">{{expanded.evidence ? '收起' : '展开'}}</view>
    </view>
    <view wx:if="{{expanded.evidence}}" class="section__body">
      <view wx:for="{{view.evidence}}" wx:key="field_key" class="row">
        <view class="row__label">{{item.field_name}}</view>
        <view class="row__value">
          <text>{{item.value || '—'}}</text>
          <view class="tiny muted">{{item.status_label}} · 来源：{{item.source_label}}<text wx:if="{{item.confidence}}"> · 自评置信 {{item.confidence}}</text></view>
          <view wx:if="{{item.raw_text}}" class="tiny faint pre-wrap">原文：{{item.raw_text}}</view>
        </view>
      </view>
      <view class="tiny faint mt8">{{view.confidenceNote}}</view>
    </view>
  </view>

  <!-- 边界说明 -->
  <view class="section">
    <view class="section__head">
      <view class="section__title">这份分析的能力边界</view>
      <view class="section__sub" bindtap="toggleSection" data-key="limits">{{expanded.limits ? '收起' : '展开'}}</view>
    </view>
    <view wx:if="{{expanded.limits}}" class="section__body">
      <view wx:for="{{view.limits}}" wx:key="*this" class="tiny muted">· {{item}}</view>
      <view class="notice notice-muted mt12 tiny">{{view.disclaimer}}</view>
    </view>
  </view>

  <view class="btn-row">
    <view class="btn btn-ghost" bindtap="reAnalyze">重新分析</view>
    <view class="btn btn-primary" bindtap="goCompare">去对比</view>
  </view>

  <view class="footer-note">
    结果保存在本机，可在"设置 → 删除我的数据"中清除。
    模式：{{view.mode === 'remote' ? '后端分析' : '本地演示/规则分析'}}。
  </view>
</view>
