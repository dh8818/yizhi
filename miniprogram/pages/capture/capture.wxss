.mt { margin-top: 16rpx; }

.thumb--add {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  width: 200rpx;
  border-style: dashed;
}

.thumb__add {
  font-size: 56rpx;
  color: #9ca3af;
  line-height: 1;
}

.demo {
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  padding: 18rpx;
  margin-bottom: 14rpx;
}

.demo--on {
  border-color: #2f6f4f;
  background: #f4faf6;
}

.demo__label { font-size: 27rpx; font-weight: 500; }
.demo__summary { color: #6b7280; margin-top: 4rpx; line-height: 1.5; }

.link { color: #2f6f4f; text-decoration: underline; }

.is-busy { opacity: 0.7; }
