<view class="page">
  <view class="card">
    <view class="h3">历史记录</view>
    <view class="tiny muted">
      全部保存在本机（小程序 storage），没有同步到云端。卸载小程序或清除数据会一并删除。
    </view>
    <view class="search-row">
      <input class="input" value="{{keyword}}" placeholder="搜索商品名称/品类/结论" bindinput="onInput" />
    </view>
    <view class="tabs">
      <view class="tab {{filter === 'all' ? 'tab--on' : ''}}" bindtap="setFilter" data-filter="all">全部 {{total}}</view>
      <view class="tab {{filter === 'fav' ? 'tab--on' : ''}}" bindtap="setFilter" data-filter="fav">收藏 {{favoriteCount}}</view>
    </view>
    <view wx:if="{{usageText}}" class="tiny faint">{{usageText}}</view>
  </view>

  <view wx:if="{{items.length === 0}}" class="card">
    <view class="empty">
      <view class="empty__title">这里还是空的</view>
      {{emptyHint}}
      <view class="btn btn-sm btn-ghost mt12" bindtap="goHome">回首页</view>
    </view>
  </view>

  <view wx:for="{{items}}" wx:key="id" class="card item">
    <view class="item__head">
      <view class="item__title nowrap" bindtap="open" data-id="{{item.id}}">{{item.name}}</view>
      <text class="fav" bindtap="toggleFav" data-id="{{item.id}}">{{item.favorite ? '★' : '☆'}}</text>
    </view>
    <view class="tiny muted" bindtap="open" data-id="{{item.id}}">
      {{item.category || '未识别品类'}} · {{item.created}}
      <text wx:if="{{item.price != null}}"> · ¥{{item.price}}</text>
      <text wx:if="{{item.demo}}" class="tag tag-warn">演示数据</text>
    </view>
    <view class="item__conclusion" bindtap="open" data-id="{{item.id}}">{{item.conclusion}}</view>
    <view class="item__foot">
      <status-tag status="{{item.level === 'high' ? 'official_verified' : item.level === 'medium' ? 'pending_verification' : 'missing'}}" label="{{item.level_label}}" />
      <text class="tiny muted">疑点：重点 {{item.doubts.attention}} · 确认 {{item.doubts.verify}}</text>
      <text class="tiny alert" bindtap="remove" data-id="{{item.id}}">删除</text>
    </view>
  </view>

  <view wx:if="{{items.length > 0}}" class="btn btn-danger btn-block mt12" bindtap="clearAll">清空全部记录</view>

  <view class="footer-note">
    本地数据 ≠ 云端数据：这里没有任何服务器副本。若需要跨设备同步，需要另外接入账号与后端存储（当前未实现）。
  </view>
</view>
