.search-row {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.search-row .input { flex: 1; }

.tabs {
  display: flex;
  gap: 12rpx;
  margin: 14rpx 0 8rpx;
}

.tab {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e5e7eb;
  color: #6b7280;
}

.tab--on {
  border-color: #2f6f4f;
  background: #eaf2ed;
  color: #2f6f4f;
}

.item { padding: 22rpx 24rpx; }

.item__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.item__title { font-size: 28rpx; font-weight: 600; flex: 1; min-width: 0; }
.fav { color: #a15c07; font-size: 30rpx; padding: 0 6rpx; }

.item__conclusion {
  font-size: 24rpx;
  color: #4b5563;
  margin-top: 8rpx;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item__foot {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

.item__foot .alert { margin-left: auto; }

.mt12 { margin-top: 12rpx; }
