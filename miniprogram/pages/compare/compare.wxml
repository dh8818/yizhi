<view class="page">
  <view class="card">
    <view class="h3">选择要比较的商品</view>
    <view class="tiny muted">从历史记录里选 2–3 件。信息更完整 ≠ 质量更好，价格更低 ≠ 更值得买。</view>
    <view wx:if="{{candidates.length === 0}}" class="empty">
      <view class="empty__title">还没有可比较的记录</view>
      <view class="btn btn-sm btn-ghost mt8" bindtap="goHistory">去历史记录</view>
    </view>
    <view wx:for="{{candidates}}" wx:key="id" class="cand {{selected.indexOf(item.id) >= 0 ? 'cand--on' : ''}}" bindtap="toggle" data-id="{{item.id}}">
      <view class="cand__check">{{selected.indexOf(item.id) >= 0 ? '✓' : ''}}</view>
      <view class="cand__main">
        <view class="cand__name nowrap">{{item.name}}</view>
        <view class="tiny muted">
          {{item.category || '未识别品类'}} · {{item.level_label}} · {{item.created}}
          <text wx:if="{{item.price != null}}"> · ¥{{item.price}}</text>
        </view>
      </view>
      <text wx:if="{{item.demo}}" class="tag tag-warn">演示</text>
    </view>
    <view class="tiny muted mt8">{{profileNote}}</view>
  </view>

  <view wx:if="{{error}}" class="notice notice-alert">{{error}}</view>

  <view class="btn btn-primary btn-block" bindtap="build">生成对比（{{selected.length}}/3）</view>

  <block wx:if="{{result}}">
    <view class="section">
      <view class="section__head"><view class="section__title">对比表</view><view class="section__sub">{{result.items.length}} 件</view></view>
      <view class="section__body">
        <view class="cmp-head">
          <view wx:for="{{result.items}}" wx:key="id" class="cmp-col">
            <view class="cmp-col__name nowrap">{{item.name}}</view>
            <view class="tiny muted">{{item.category || '—'}}</view>
          </view>
        </view>

        <view wx:for="{{result.rows}}" wx:key="label" class="cmp-row">
          <view class="cmp-row__label">{{item.label}}</view>
          <view class="cmp-cells">
            <view wx:for="{{item.cells}}" wx:for-item="cell" wx:key="i" class="cmp-cell">
              <view wx:for="{{cell.lines}}" wx:for-item="line" wx:key="value" class="cmp-line cmp-{{line.status}}">
                <text>{{line.value}}</text>
                <view wx:if="{{line.note}}" class="tiny muted">{{line.note}}</view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section__head"><view class="section__title">建议（与你的偏好挂钩）</view><view class="section__sub" bindtap="copySuggestion">复制</view></view>
      <view class="section__body">
        <view wx:if="{{result.suggestion.preferences.length}}" class="tiny muted">你的偏好：{{result.suggestion.preferences}}</view>
        <view wx:for="{{result.suggestion.lines}}" wx:key="*this" class="suggest-line">· {{item}}</view>
        <view class="notice notice-info mt12">{{result.suggestion.next_step}}</view>
        <view class="tiny faint mt8">{{result.suggestion.basis}}</view>
      </view>
    </view>

    <view class="notice notice-muted">{{result.disclaimer}}</view>
  </block>
</view>
