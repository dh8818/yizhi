.cand {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 14rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  margin-top: 14rpx;
}

.cand--on {
  border-color: #2f6f4f;
  background: #f4faf6;
}

.cand__check {
  width: 40rpx;
  height: 40rpx;
  line-height: 38rpx;
  text-align: center;
  border-radius: 8rpx;
  border: 1rpx solid #cfd6dd;
  color: #2f6f4f;
  font-size: 26rpx;
  flex: none;
}

.cand--on .cand__check {
  border-color: #2f6f4f;
  background: #2f6f4f;
  color: #fff;
}

.cand__main { flex: 1; min-width: 0; }
.cand__name { font-size: 27rpx; font-weight: 500; }

.cmp-head {
  display: flex;
  gap: 10rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #e5e7eb;
}

.cmp-col { flex: 1; min-width: 0; }
.cmp-col__name { font-size: 25rpx; font-weight: 600; }

.cmp-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}

.cmp-row:last-child { border-bottom: none; }

.cmp-row__label {
  font-size: 23rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.cmp-cells {
  display: flex;
  gap: 10rpx;
}

.cmp-cell {
  flex: 1;
  min-width: 0;
  background: #fafbfc;
  border: 1rpx solid #eceef0;
  border-radius: 10rpx;
  padding: 12rpx;
}

.cmp-line {
  font-size: 23rpx;
  line-height: 1.55;
  border-left: 4rpx solid transparent;
  padding-left: 8rpx;
  margin-bottom: 6rpx;
}

.cmp-line:last-child { margin-bottom: 0; }

.cmp-ok { border-left-color: #1a7f37; }
.cmp-warn { border-left-color: #a15c07; }
.cmp-alert { border-left-color: #b42318; }
.cmp-info, .cmp-extracted { border-left-color: #2f6f4f; }
.cmp-missing { border-left-color: #d1d5db; color: #9ca3af; }
.cmp-official_verified { border-left-color: #1a7f37; }
.cmp-pending_verification { border-left-color: #a15c07; }
.cmp-inferred, .cmp-conflict { border-left-color: #a15c07; }

.suggest-line {
  font-size: 25rpx;
  color: #374151;
  line-height: 1.7;
  margin-top: 6rpx;
}

.mt8 { margin-top: 8rpx; }
.mt12 { margin-top: 12rpx; }
