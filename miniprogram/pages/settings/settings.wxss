.mode-row {
  display: flex;
  gap: 14rpx;
}

.mode {
  flex: 1;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  padding: 18rpx;
}

.mode--on {
  border-color: #2f6f4f;
  background: #f4faf6;
}

.mode__title { font-size: 27rpx; font-weight: 600; }
.mode__desc { font-size: 22rpx; color: #6b7280; margin-top: 6rpx; line-height: 1.5; }

.mt8 { margin-top: 8rpx; }
.mt12 { margin-top: 12rpx; }
