<view class="page">
  <view class="card">
    <view class="h3">查标准号</view>
    <view class="tiny muted">
      支持 GB / GB/T / FZ/T 等写法，可只写号不写年份。数据来自 openstd.samr.gov.cn 的实时核验（核验日期 {{dataset.generated_at}}）。
    </view>
    <view class="search-row">
      <input class="input" value="{{query}}" placeholder="例如：GB 18401 或 18401" bindinput="onInput" bindconfirm="doSearch" confirm-type="search" />
      <view class="btn btn-primary btn-sm" bindtap="doSearch">查询</view>
    </view>
    <scroll-view class="quick" scroll-x="true">
      <text wx:for="{{results}}" wx:key="standard_number" class="quick__item" bindtap="openResult" data-code="{{item.standard_number}}">{{item.standard_number}}</text>
    </scroll-view>
  </view>

  <view wx:if="{{results.length}}" class="section">
    <view class="section__head"><view class="section__title">结果</view><view class="section__sub">{{results.length}} 条</view></view>
    <view class="section__body">
      <view wx:for="{{results}}" wx:key="standard_number" class="result" bindtap="openResult" data-code="{{item.standard_number}}">
        <view class="result__head">
          <text class="result__code">{{item.standard_number}}</text>
          <text class="tag tag-{{item.tone}}">{{item.status_label}}</text>
        </view>
        <view class="result__name">{{item.name}}</view>
        <view class="tiny muted">核验：{{item.verification_status === 'official_verified' ? '官方页面已核验' : '待人工核验'}} · {{item.last_verified_at}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{hints.length}}" class="card">
    <view class="h3">品类常见标准提示</view>
    <view wx:for="{{hints}}" wx:key="category" class="hint">
      <view class="tiny strong">{{item.category}}</view>
      <view class="tiny muted">{{item.standards}}</view>
    </view>
    <view class="tiny faint">这只是"该查哪些标准"的提示，不代表商品必须引用其中某一条。</view>
  </view>

  <view wx:if="{{detail}}" class="section">
    <view class="section__head">
      <view class="section__title">{{detail.standard_number}}</view>
      <view class="section__sub" bindtap="closeDetail">关闭</view>
    </view>
    <view class="section__body">
      <view class="row">
        <view class="row__label">状态</view>
        <view class="row__value">
          <text class="tag tag-{{detail.tone}}">{{detail.record ? detail.record.status_label : '未核验'}}</text>
          <text class="tiny muted"> {{detail.label}}</text>
        </view>
      </view>
      <block wx:if="{{detail.record}}">
        <view class="row"><view class="row__label">标准名称</view><view class="row__value">{{detail.record.name}}</view></view>
        <view wx:if="{{detail.record.name_en}}" class="row"><view class="row__label">英文名称</view><view class="row__value tiny">{{detail.record.name_en}}</view></view>
        <view class="row"><view class="row__label">标准性质</view><view class="row__value">{{detail.record.standard_type}}</view></view>
        <view class="row"><view class="row__label">发布日期</view><view class="row__value">{{detail.record.publication_date || '—'}}</view></view>
        <view class="row"><view class="row__label">实施日期</view><view class="row__value">{{detail.record.implementation_date || '—'}}</view></view>
        <view class="row"><view class="row__label">主管/归口</view><view class="row__value tiny">{{detail.record.competent_department || '—'}} / {{detail.record.issuing_body || '—'}}</view></view>
        <view class="row"><view class="row__label">CCS / ICS</view><view class="row__value tiny">{{detail.record.ccs || '—'}} / {{detail.record.ics || '—'}}</view></view>
        <view class="row"><view class="row__label">核验时间</view><view class="row__value tiny">{{detail.record.last_verified_at}}</view></view>
      </block>

      <view wx:if="{{detail.editorial}}" class="sub-block">
        <view class="h3">编辑整理（非官方页面字段）</view>
        <view class="tiny muted">角色：{{detail.editorial.role}}</view>
        <view wx:if="{{detail.editorial.applicability_by_name.length}}" class="tiny">依据标准名称：{{detail.editorial.applicability_by_name}}</view>
        <view wx:if="{{detail.editorial.key_requirement_topics.length}}" class="tiny">
          常见管控项目类别：{{detail.editorial.key_requirement_topics}}
          <text wx:if="{{!detail.editorial.key_requirements_verified}}">（未逐条核对正文，不含条款号与限值）</text>
        </view>
        <view wx:for="{{detail.editorial.notes}}" wx:key="*this" class="tiny warn">· {{item}}</view>
      </view>

      <view wx:if="{{detail.versions.length}}" class="sub-block">
        <view class="h3">版本记录</view>
        <view wx:for="{{detail.versions}}" wx:key="standard_number" class="tiny">
          {{item.standard_number}} · {{item.status_label}} · 发布 {{item.publication_date || '—'}} · 实施 {{item.implementation_date || '—'}}
        </view>
      </view>

      <view class="notice notice-muted mt12">
        <view class="notice__title">范围条款没有收录</view>
        官方公开页面只提供标准号、名称、状态、日期等字段；范围与条款需要查阅标准正文（官方"在线预览"）。本系统不代填、不虚构条款内容。
      </view>

      <view class="btn btn-ghost btn-sm mt12" bindtap="copySource">{{copied ? '链接已复制，可再复制' : '复制官方查询链接'}}</view>
      <view wx:if="{{detail.official_source_url}}" class="tiny faint pre-wrap mt8">{{detail.official_source_url}}</view>
    </view>
  </view>

  <view class="card">
    <view class="h3">核验口径</view>
    <view class="tiny muted">
      {{dataset.disclaimer}}
    </view>
    <view class="tiny faint mt8">数据源：{{dataset.source}}</view>
  </view>
</view>
