/* 衣知 · 全局样式
 *
 * 设计取向：白底、深墨绿强调色、克制的边框与留白。
 * 目标是把"信息状态"（已识别/未提供/冲突/待核实）做得比"好看"更重要。
 */

page {
  --bg: #f4f5f7;
  --card: #ffffff;
  --text: #1c1f23;
  --muted: #6b7280;
  --faint: #9ca3af;
  --line: #e5e7eb;
  --accent: #2f6f4f;
  --accent-soft: #eaf2ed;
  --ok: #1a7f37;
  --ok-soft: #e7f4ea;
  --warn: #a15c07;
  --warn-soft: #fdf3e2;
  --alert: #b42318;
  --alert-soft: #fbeae8;
  --info: #2b5d8a;
  --info-soft: #eaf1f8;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.65;
}

.page {
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

/* ───────── 卡片与标题 ───────── */

.card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--line);
}

.card--flat {
  box-shadow: none;
}

.section {
  background: var(--card);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--line);
  overflow: hidden;
}

.section__head {
  padding: 24rpx 28rpx 12rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.section__title {
  font-size: 32rpx;
  font-weight: 600;
  position: relative;
  padding-left: 18rpx;
}

.section__title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10rpx;
  bottom: 10rpx;
  width: 6rpx;
  border-radius: 3rpx;
  background: var(--accent);
}

.section__sub {
  font-size: 24rpx;
  color: var(--muted);
}

.section__body {
  padding: 8rpx 28rpx 28rpx;
}

/* ───────── 文本 ───────── */

.h1 { font-size: 44rpx; font-weight: 700; letter-spacing: 0.5rpx; }
.h2 { font-size: 34rpx; font-weight: 600; }
.h3 { font-size: 30rpx; font-weight: 600; }
.muted { color: var(--muted); }
.faint { color: var(--faint); }
.small { font-size: 24rpx; }
.tiny { font-size: 22rpx; }
.strong { font-weight: 600; }
.warn { color: var(--warn); }
.alert { color: var(--alert); }
.ok { color: var(--ok); }
.nowrap { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pre-wrap { white-space: pre-wrap; word-break: break-word; }

/* ───────── 标签（状态） ───────── */

.tag {
  display: inline-block;
  font-size: 22rpx;
  line-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid transparent;
  vertical-align: middle;
}

.tag + .tag { margin-left: 8rpx; }

.tag-info { color: var(--info); background: var(--info-soft); }
.tag-ok { color: var(--ok); background: var(--ok-soft); }
.tag-warn { color: var(--warn); background: var(--warn-soft); }
.tag-alert { color: var(--alert); background: var(--alert-soft); }
.tag-muted { color: var(--muted); background: #f3f4f6; }
.tag-accent { color: var(--accent); background: var(--accent-soft); }

/* ───────── 行 ───────── */

.row {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}

.row:last-child { border-bottom: none; }

.row__label {
  width: 200rpx;
  flex: none;
  color: var(--muted);
  font-size: 26rpx;
}

.row__value {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  word-break: break-word;
}

.row__side {
  flex: none;
  margin-left: 12rpx;
}

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 20rpx 0;
}

/* ───────── 按钮 ───────── */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--line);
  background: #fff;
  color: var(--text);
}

.btn::after { border: none; }

.btn-primary {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
}

.btn-ghost {
  background: #fff;
  border-color: var(--accent);
  color: var(--accent);
}

.btn-danger {
  background: #fff;
  border-color: var(--alert);
  color: var(--alert);
}

.btn-sm {
  height: 60rpx;
  font-size: 24rpx;
  border-radius: 10rpx;
  padding: 0 18rpx;
}

.btn-block { width: 100%; }

.btn[disabled] {
  opacity: 0.5;
}

.btn-row {
  display: flex;
  gap: 16rpx;
}

.btn-row .btn { flex: 1; }

/* ───────── 上传区 ───────── */

.uploader {
  border: 2rpx dashed #cfd6dd;
  border-radius: 18rpx;
  padding: 40rpx 24rpx;
  text-align: center;
  background: #fbfcfd;
}

.uploader__title { font-size: 30rpx; font-weight: 600; color: var(--accent); }
.uploader__hint { font-size: 24rpx; color: var(--muted); margin-top: 8rpx; }

.thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.thumb {
  width: 200rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  overflow: hidden;
  background: #fff;
  position: relative;
}

.thumb__img {
  width: 100%;
  height: 200rpx;
  display: block;
  background: #f3f4f6;
}

.thumb__meta {
  padding: 8rpx 10rpx 10rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.thumb__remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 42rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 26rpx;
}

/* ───────── 提示块 ───────── */

.notice {
  border-radius: 14rpx;
  padding: 20rpx 22rpx;
  font-size: 25rpx;
  line-height: 1.7;
  border: 1rpx solid transparent;
}

.notice-info { background: var(--info-soft); color: #234a6d; border-color: #d5e3f1; }
.notice-warn { background: var(--warn-soft); color: #7a4505; border-color: #f2dfc0; }
.notice-alert { background: var(--alert-soft); color: #8a1c13; border-color: #f3d3cf; }
.notice-ok { background: var(--ok-soft); color: #14622c; border-color: #cfe6d5; }
.notice-muted { background: #f5f6f7; color: var(--muted); border-color: var(--line); }

.notice__title { font-weight: 600; margin-bottom: 6rpx; }

/* ───────── 空状态 ───────── */

.empty {
  padding: 60rpx 24rpx;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
}

.empty__title { font-size: 30rpx; color: var(--text); margin-bottom: 8rpx; font-weight: 600; }

/* ───────── 输入 ───────── */

.field {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}

.field:last-child { border-bottom: none; }

.field__label {
  font-size: 25rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}

.input {
  height: 76rpx;
  background: #f7f8f9;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 0 18rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  width: 100%;
}

.textarea {
  min-height: 160rpx;
  background: #f7f8f9;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
  font-size: 27rpx;
  box-sizing: border-box;
  width: 100%;
}

.picker-value {
  height: 76rpx;
  line-height: 76rpx;
  background: #f7f8f9;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 0 18rpx;
  font-size: 27rpx;
}

/* ───────── 网格（首页入口） ───────── */

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.grid__item {
  flex: 1 1 calc(50% - 8rpx);
  min-width: 260rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 22rpx;
  box-sizing: border-box;
}

.grid__title { font-size: 28rpx; font-weight: 600; margin-bottom: 4rpx; }
.grid__desc { font-size: 22rpx; color: var(--muted); line-height: 1.5; }

/* ───────── 进度/加载 ───────── */

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 40rpx;
  color: var(--muted);
  font-size: 26rpx;
}

.progress {
  height: 8rpx;
  border-radius: 4rpx;
  background: #eaedf0;
  overflow: hidden;
  margin: 16rpx 0;
}

.progress__bar {
  height: 100%;
  background: var(--accent);
  transition: width 0.2s linear;
}

/* ───────── 结论卡 ───────── */

.verdict {
  background: linear-gradient(180deg, #f7faf8 0%, #ffffff 100%);
  border: 1rpx solid #d9e7de;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
}

.verdict__label {
  font-size: 22rpx;
  color: var(--accent);
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.verdict__text {
  font-size: 30rpx;
  line-height: 1.7;
  font-weight: 500;
}

.verdict__meta {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: var(--muted);
}

/* ───────── 疑点条目 ───────── */

.doubt {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}

.doubt:last-child { border-bottom: none; }
.doubt__head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.doubt__title { font-size: 28rpx; font-weight: 600; flex: 1; min-width: 0; }
.doubt__reason { font-size: 25rpx; color: #374151; margin-top: 8rpx; }
.doubt__action { font-size: 24rpx; color: var(--accent); margin-top: 8rpx; }
.doubt__basis { font-size: 22rpx; color: var(--muted); margin-top: 8rpx; }

/* ───────── 对比表 ───────── */

.compare-row { padding: 18rpx 0; border-bottom: 1rpx solid #f0f1f3; }
.compare-row__label { font-size: 25rpx; color: var(--muted); margin-bottom: 10rpx; }
.compare-cells { display: flex; gap: 12rpx; }
.compare-cell {
  flex: 1;
  min-width: 0;
  background: #fafbfc;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 14rpx;
  font-size: 24rpx;
}

.footer-note {
  margin: 32rpx 8rpx 16rpx;
  font-size: 22rpx;
  color: var(--faint);
  line-height: 1.7;
  text-align: center;
}
