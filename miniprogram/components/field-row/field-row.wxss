.value-text {
  font-size: 27rpx;
  font-weight: 500;
  color: #1c1f23;
}

.value-meta {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.note {
  color: #6b7280;
  margin-top: 6rpx;
  line-height: 1.5;
}

.alt {
  color: #9ca3af;
  margin-top: 4rpx;
}

.edit-line {
  padding: 0 0 14rpx 200rpx;
}

.accent {
  color: #2f6f4f;
}

.src {
  font-size: 22rpx;
}
