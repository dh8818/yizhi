# ─── 运行模式 ────────────────────────────────────────────────
# local  = 本机演示模式（无后端、无模型，全部结果带「演示数据」标记）
# remote = 走后端 API（server/ 或自建），后端再决定模型走正式还是模拟
YIZHI_MODE=local

# 小程序端使用的后端地址（remote 模式必填；真机必须 https 且已在小程序后台配置 request 合法域名）
YIZHI_API_BASE=http://127.0.0.1:8787

# ─── OCR 提供方（仅服务端读取，绝不进小程序包）────────────────
# auto   = 按已填写的凭据自动选：百度 → OpenAI 兼容 → Ollama → mock
# 可选值：ollama | openai | baidu | mock
YIZHI_OCR_PROVIDER=auto
YIZHI_OCR_TIMEOUT_MS=45000
# provider 调用失败时：demo = 用示例文本降级并标注（开发方便）；off = 直接报错（生产建议）
YIZHI_OCR_FALLBACK=demo

# ① 本机 Ollama 视觉模型（免费、离线；先执行 `ollama pull qwen2.5vl:3b`）
YIZHI_OLLAMA_HOST=http://127.0.0.1:11434
YIZHI_OLLAMA_MODEL=qwen2.5vl:3b

# ② 任意 OpenAI 兼容的视觉接口（通义 DashScope / 硅基流动 / 智谱 / 豆包 / OpenAI）
# 例：YIZHI_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#     YIZHI_VISION_MODEL=qwen-vl-max
YIZHI_VISION_BASE_URL=
YIZHI_VISION_MODEL=
YIZHI_VISION_API_KEY=

# ③ 百度通用文字识别（高精度版）：控制台 → 文字识别 → 应用 → API Key / Secret Key
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
# 可选：换接口（默认 accurate_basic 高精度版）
BAIDU_OCR_ENDPOINT=

# ─── 服务端 ──────────────────────────────────────────────────
PORT=8787
# 数据目录（JSON 文件存储，非生产级数据库）
YIZHI_DATA_DIR=./server/data
# 允许访问后端的小程序 AppID（留空则不校验，仅限本地开发）
YIZHI_ALLOWED_APPIDS=
# 请求体上限（字节）
YIZHI_MAX_BODY_BYTES=8388608
