# ─── 运行模式 ────────────────────────────────────────────────
# local  = 本机演示模式（无后端、无模型，全部结果带「演示数据」标记）
# remote = 走后端 API（server/ 或自建），后端再决定模型走正式还是模拟
YIZHI_MODE=local

# 小程序端使用的后端地址（remote 模式必填；真机必须 https 且已在小程序后台配置 request 合法域名）
YIZHI_API_BASE=http://127.0.0.1:8787

# ─── 视觉模型（仅服务端读取，绝不进小程序包）─────────────────
# OpenAI 兼容的视觉接口；留空则服务端自动降级为 mock 提取器
YIZHI_VISION_PROVIDER=
YIZHI_VISION_BASE_URL=
YIZHI_VISION_MODEL=
YIZHI_VISION_API_KEY=
YIZHI_VISION_TIMEOUT_MS=45000

# ─── 服务端 ──────────────────────────────────────────────────
PORT=8787
# 数据目录（JSON 文件存储，非生产级数据库）
YIZHI_DATA_DIR=./server/data
# 允许访问后端的小程序 AppID（留空则不校验，仅限本地开发）
YIZHI_ALLOWED_APPIDS=
# 请求体上限（字节）
YIZHI_MAX_BODY_BYTES=8388608
